local function addButton(parent, name, color, callback)
    local btnHeight = isPC and 38 : 30
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, btnHeight)
    Btn.BackgroundColor3 = color
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Text = name
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = isPC and 11 : 9
    Btn.Parent = parent
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 5)
    Corner.Parent = Btn
    
    Btn.MouseButton1Click:Connect(function()
        local tweenInfo = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(Btn, tweenInfo, {Size = UDim2.new(0.97, 0, 0, btnHeight - 4)}):Play()
        task.wait(0.06)
        TweenService:Create(Btn, tweenInfo, {Size = UDim2.new(1, 0, 0, btnHeight)}):Play()
        pcall(callback)
    end)
end

